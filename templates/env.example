# Login dengan authmein (https://auth.me.in). Salin ke .env (yang TIDAK pernah di-commit) dan isi.
# Satu client_id = satu aplikasi di satu environment (dev/beta/prod): jangan berbagi client_id antar environment.

# Kosong = https://auth.me.in. Untuk uji lokal dengan tiruan: http://127.0.0.1:9099 (cmd/fakeauthmein)
AUTHMEIN_ISSUER=
# client_id dari pendaftaran client (publik, bukan rahasia, tetapi milik environment ini)
AUTHMEIN_CLIENT_ID=
# Alamat publik aplikasi. Callback = $PUBLIC_BASE_URL/auth/authmein/callback dan HARUS persis sama dengan yang didaftarkan
# (callback client tidak bisa diubah setelah dibuat: pindah alamat = client baru).
PUBLIC_BASE_URL=https://app.example
# RAHASIA. >= 32 karakter acak (mis. `openssl rand -base64 48`). Menandatangani cookie alur login. Jangan di repo.
SESSION_SECRET=
# true untuk https (produksi). false HANYA untuk http://localhost saat pengembangan.
COOKIE_SECURE=true
# Siapa boleh masuk adalah keputusan APLIKASI, bukan authmein. Contoh: admin pertama (tanpa entri allowlist).
ADMIN_EMAILS=
